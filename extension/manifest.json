{
  "manifest_version": 3,
  "name": "InkTeX",
  "version": "0.1.0",
  "description": "Draw math equations freehand. Get instant LaTeX + computed answers. Fully offline — CNN inference runs in WebAssembly.",

  "action": {
    "default_popup": "popup.html",
    "default_title": "InkTeX",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "permissions": [],

  "web_accessible_resources": [
    {
      "resources": ["model/model.onnx", "model/classes.json", "lib/**"],
      "matches": ["<all_urls>"]
    }
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}
